      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: #aee1f9;   /* bleu clair pastel */
    color: #1b4f72;              /* bleu foncé lisible */
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: bold;
    border: 2px solid #87cdee;   /* contour léger */
}

/* Hover – plus vif */
QPushButton:hover {
    background-color: #87cdee;   /* bleu un peu plus foncé */
    border-color: #5ab3d6;
}

/* Pressed – effet enfoncé */
QPushButton:pressed {
    background-color: #74c0e3;   /* bleu plus soutenu */
    border-color: #4c9fcf;
}

/* Optionnel : effet de transition */
QPushButton {
    transition: 0.25s;
}
</string>
