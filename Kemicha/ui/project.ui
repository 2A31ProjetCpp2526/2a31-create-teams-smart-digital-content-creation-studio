          <item>
           <widget class="QPushButton" name="searchprojet">
            <property name="styleSheet">
             <string notr="true">QPushButton {
    background-color: #ff4da6;      /* Rose vif */
    color: white;
    border: none;
    border-radius: 4px;             /* Rectangle avec léger arrondi */
    padding: 6px 14px;              /* Taille normale */
    font-weight: 600;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.3px;
    transition: all 0.2s ease-in-out;
}

QPushButton:hover {
    background-color: #ff1f8f;      /* Rose plus foncé */
    box-shadow: 0 4px 14px rgba(255, 77, 166, 0.5);
    transform: translateY(-2px);
}

QPushButton:pressed {
    background-color: #e60073;      /* Rose profond */
    transform: translateY(0px);
    box-shadow: 0 2px 6px rgba(255, 77, 166, 0.3);
}
</string>
            </property>
            <property name="text">
