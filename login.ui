              <property name="styleSheet">
               <string notr="true">QLineEdit#emailLineEdit {
    padding: 18px 22px;
    border: 1.5px solid #e1e5e9;
    border-radius: 12px;
    background-color: #ffffff;
    color: #2c3e50;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 0.8px;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
QLineEdit#emailLineEdit:focus {
    border-color: #87CEEB;
    outline: none;
    box-shadow: 0 0 0 4px rgba(135, 206, 235, 0.25), 0 8px 20px rgba(135, 206, 235, 0.15);
    transform: scale(1.02);
    background-color: rgba(135, 206, 235, 0.02);
}
QLineEdit#emailLineEdit:hover {
    border-color: #87CEEB;
    box-shadow: 0 6px 16px rgba(135, 206, 235, 0.2);
    transform: translateY(-2px);
}</string>
