               </font>
              </property>
              <property name="styleSheet">
               <string notr="true">QLabel#loginTitle {
    color: #1a1a1a;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 36px;
    letter-spacing: 2px;
    background-color: transparent;
    padding: 0px 0px 32px 0px;
    text-align: center;
    margin-bottom: 20px;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-transform: uppercase;
}
QLabel#loginTitle:hover {
    color: #0f1419;
    text-shadow: 0 0 25px rgba(135, 206, 235, 0.9), 0 0 50px rgba(135, 206, 235, 0.6);
    transform: scale(1.05);
    letter-spacing: 3px;
}</string>
              </property>
              <property name="text">
               <string>Welcome Back</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignCenter</set>
              </property>
