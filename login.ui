              <property name="styleSheet">
               <string notr="true">QPushButton#signUpButton {
    background-color: transparent;
    color: #87CEEB;
    border: 2.5px solid #87CEEB;
    border-radius: 16px;
    padding: 18px 32px;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 4px 12px rgba(135, 206, 235, 0.3);
}
QPushButton#signUpButton:hover {
    background-color: rgba(135, 206, 235, 0.1);
    color: #2c3e50;
    border-color: #ADD8E6;
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 40px rgba(135, 206, 235, 0.6), 0 0 30px rgba(135, 206, 235, 0.8);
    text-shadow: 0 0 20px rgba(135, 206, 235, 1.0);
    letter-spacing: 2px;
}
QPushButton#signUpButton:pressed {
    background-color: rgba(135, 206, 235, 0.2);
    color: #2c3e50;
    border-color: #5DADE2;
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 12px 30px rgba(135, 206, 235, 0.5);
}</string>
              </property>
