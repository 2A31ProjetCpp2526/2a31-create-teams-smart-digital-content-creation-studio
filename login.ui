            <!-- Login Button -->
            <item>
             <widget class="QPushButton" name="loginButton">
              <property name="minimumSize">
               <size>
                <width>0</width>
                <height>52</height>
               </size>
              </property>
              <property name="font">
               <font>
                <family>Poppins Slim</family>
                <pointsize>15</pointsize>
                <weight>700</weight>
               </font>
              </property>
              <property name="styleSheet">
               <string notr="true">QPushButton#loginButton {
    background: linear-gradient(135deg, #87CEEB 0%, #5DADE2 100%);
    color: #ffffff;
    border: none;
    border-radius: 16px;
    padding: 18px 32px;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 8px 24px rgba(135, 206, 235, 0.4);
}
QPushButton#loginButton:hover {
    background: linear-gradient(135deg, #ADD8E6 0%, #87CEEB 100%);
    color: #2c3e50;
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 16px 40px rgba(173, 216, 230, 0.7);
    text-shadow: 0 0 20px rgba(255, 255, 255, 1.0);
    letter-spacing: 2px;
}
QPushButton#loginButton:pressed {
    background: linear-gradient(135deg, #5DADE2 0%, #87CEEB 100%);
    color: #2c3e50;
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 12px 30px rgba(135, 206, 235, 0.5);
}</string>
              </property>
              <property name="text">
               <string>Login</string>
              </property>
