              <property name="styleSheet">
               <string notr="true">QLabel#emailLabel {
    color: #2c3e50;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 1px;
    padding: 14px 0px;
    margin-bottom: 10px;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-transform: uppercase;
}
QLabel#emailLabel:hover {
    color: #0f1419;
    text-shadow: 0 0 20px rgba(135, 206, 235, 1.0), 0 4px 8px rgba(135, 206, 235, 0.6);
    transform: translateX(6px) scale(1.03);
    letter-spacing: 1.5px;
}</string>
