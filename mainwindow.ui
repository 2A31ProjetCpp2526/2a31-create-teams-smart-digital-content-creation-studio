      </property>
      <property name="styleSheet">
       <string notr="true">QCheckBox {
    spacing: 8px;
    font: 11pt &quot;Segoe UI&quot;;
    color: #2c3e50;
}

/* Style de la case (vide) */
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px; /* arrondi */
    border: 2px solid #3498db; /* contour bleu */
    background: #ffffff;
}

/* Quand on passe la souris dessus */
QCheckBox::indicator:hover {
    border: 2px solid #2980b9; 
}

/* Quand elle est cochée */
QCheckBox::indicator:checked {
    background-color: #3498db;  /* fond bleu */
    image: url(:/icons/check.png); /* ✅ icône check */
}
</string>
