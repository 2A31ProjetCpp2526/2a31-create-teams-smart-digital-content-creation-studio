           <item>
            <widget class="QPushButton" name="loginBtn">
             <property name="minimumSize">
              <size>
               <width>120</width>
               <height>38</height>
              </size>
             </property>
             <property name="font">
              <font>
               <family>Poppins</family>
               <pointsize>-1</pointsize>
               <bold>true</bold>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #007bff, stop:1 #33ccff
    ); /* Dégradé bleu néon */
    color: white;
    border: none;
    border-radius: 17px;
    padding: 6px 20px;       /* un peu plus petit */
    font-family: 'Poppins', sans-serif; /* Poppins */
    font-weight: 700;         /* gras */
    font-size: 15px;
    letter-spacing: 0.5px;    /* espacement comme fourni */
    text-transform: none;     /* Login normal, pas uppercase */
    outline: none;
    position: relative;

    /* Ombre néon + profondeur 3D */
    box-shadow:
        0 0 8px rgba(0, 123, 255, 0.6),
        0 4px 12px rgba(0, 0, 0, 0.25);

    /* Transition fluide */
    transition: all 0.3s ease;
}

/* Hover – glow + légère expansion */
QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #3399ff, stop:1 #66ccff
    );
    box-shadow:
        0 0 18px rgba(51, 153, 255, 0.8),
        0 6px 16px rgba(0, 0, 0, 0.3);
    transform: scale(1.08);
}

/* Pressed – effet enfoncé 3D */
QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0056b3, stop:1 #0099ff
    );
    box-shadow:
        0 0 6px rgba(0, 102, 255, 0.5),
        inset 0 2px 6px rgba(0, 0, 0, 0.3);
    transform: scale(0.96) translateY(2px);
}

/* Reflet animé subtil */
QPushButton::after {
    content: &quot;&quot;;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 17px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.2),
        stop:1 rgba(255,255,255,0)
    );
    opacity: 0;
    transition: opacity 0.4s ease;
}

QPushButton:hover::after {
    opacity: 1;
}

/* Animation “neon pulse” */
@keyframes neonPulse {
    0% { box-shadow: 0 0 8px rgba(0, 123, 255, 0.5), 0 4px 12px rgba(0,0,0,0.25);}
    50% { box-shadow: 0 0 20px rgba(0, 153, 255, 0.9), 0 6px 16px rgba(0,0,0,0.3);}
    100% { box-shadow: 0 0 8px rgba(0, 123, 255, 0.5), 0 4px 12px rgba(0,0,0,0.25);}
}

QPushButton {
    animation: neonPulse 2.5s infinite ease-in-out;
}
</string>
             </property>
             <property name="text">
              <string>Login</string>
             </property>
            </widget>
