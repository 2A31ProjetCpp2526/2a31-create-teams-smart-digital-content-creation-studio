                     <property name="styleSheet">
                      <string notr="true">QPushButton {
    background-color: #6c757d;
    color: #adb5bd;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
}

QPushButton:enabled {
    background-color: #ffb74d; /* Light orange base */
    color: #1f2937;
    transition: all 0.2s ease-in-out;
}

QPushButton:enabled:hover {
    background-color: #ff9e40; /* Deeper orange on hover */
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(255, 183, 77, 0.45);
}

QPushButton:enabled:pressed {
    background-color: #fb8c00; /* Pressed orange */
    transform: translateY(0px);
    box-shadow: 0 2px 6px rgba(255, 183, 77, 0.30);
}

QPushButton:disabled {
    background-color: #6c757d;
    color: #adb5bd;
    box-shadow: none;
}</string>
                     </property>
