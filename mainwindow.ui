                  <property name="styleSheet">
                   <string notr="true">QTableWidget {
    border: 1px solid #dee2e6;
    border-radius: 12px;
    background-color: #ffffff;
    gridline-color: transparent;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: #ffffff;
    selection-background-color: transparent;
    outline: none;
}

QTableWidget:focus {
    border: 2px solid #1da1f2;
    box-shadow: 0 0 10px rgba(29, 161, 242, 0.3);
}

QTableWidget::item {
    padding: 25px 12px;
    border: none;
    border-bottom: 1px solid #f1f3f4;
    min-height: 90px;
    max-height: 90px;
    background-color: transparent;
    color: #ffffff;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-weight: 300;
    font-size: 14px;
    transition: all 0.3s ease-in-out;
}

QTableWidget::item:hover {
    background-color: rgba(200, 200, 200, 0.08);
    border-radius: 6px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease-in-out;
    transform: none; /* Prevent layout shift */
}

QTableWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: 300;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    position: relative;
}

QTableWidget::item:selected:before {
    content: &quot;✓&quot;;
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #2c3e50;
    border-radius: 10px;
    width: 20px;
    height: 20px;
    text-align: center;
    font-size: 12px;
    font-weight: bold;
}

QTableWidget::item:selected:hover {
    background-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

QHeaderView::section {
    background-color: #f8f9fa;
    padding: 18px 12px;
    border: none;
    border-bottom: 3px solid #1da1f2;
    font-weight: 700;
    font-size: 14px;
    color: #2c3e50;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    min-height: 45px;
    transition: all 0.2s ease-in-out;
}

QHeaderView::section:hover {
    background-color: rgba(29, 161, 242, 0.05);
    color: #1da1f2;
}

/* Selection Column Styling */
QTableWidget::item[column=&quot;0&quot;] {
    padding: 12px;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    margin: 6px;
    min-width: 40px;
    min-height: 40px;
    font-size: 18px;
    color: #ffffff;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-weight: 300;
}

QTableWidget::item[column=&quot;0&quot;]:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    cursor: pointer;
    transform: scale(1.1);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
}

QTableWidget::item[column=&quot;0&quot;]:selected {
    background-color: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.5);
    color: #ffffff;
}

/* Avatar Column Styling - New Position at Column 1 */
QTableWidget::item[column=&quot;1&quot;] {
    padding: 4px;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 0px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    margin: 4px;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-weight: 300;
    color: #ffffff;
}

QTableWidget::item[column=&quot;1&quot;]:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.4);
    transform: scale(1.02);
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.12);
}

/* Name Column Bold Styling - Updated Position */
QTableWidget::item[column=&quot;3&quot;] {
    font-weight: 500;
    font-size: 16px;
    color: #ffffff;
    padding-left: 20px;
    letter-spacing: 0.3px;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    background-color: transparent;
}

QTableWidget::item[column=&quot;3&quot;]:hover {
    color: #ffffff;
    font-weight: 500;
    background-color: rgba(200, 200, 200, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    border-radius: 6px;
    transition: all 0.2s ease-in-out;
}

/* Email Column Styling - Updated Position */
QTableWidget::item[column=&quot;4&quot;] {
    color: #ffffff;
    font-style: normal;
    font-size: 14px;
    font-weight: 300;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
}

QTableWidget::item[column=&quot;4&quot;]:hover {
    color: #ffffff;
    font-style: normal;
}

/* Role Column Styling - Updated Position */
QTableWidget::item[column=&quot;5&quot;] {
    color: #ffffff;
    font-weight: 300;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    background-color: rgba(255, 255, 255, 0.05);
