       <string notr="true">QTableWidget {
    background-color: #f2f2f2;   /* gris très clair, proche du blanc */
    gridline-color: #bdc3c7;     /* couleur des lignes */
    font: 11pt &quot;Segoe UI&quot;;
    color: #000000;              /* texte en noir */
    selection-background-color: #3498db; /* fond bleu quand sélectionné */
    selection-color: #ffffff;    /* texte blanc quand sélectionné */
    border: 2px solid #3498db;
    border-radius: 6px;
}

QTableWidget::item {
    background-color: #f2f2f2; /* gris clair pour chaque cellule */
    color: #000000;            /* texte noir dans les cellules */
}

QHeaderView::section {
