    <property name="styleSheet">
     <string notr="true">QTabBar::tab {
    background: white;             /* white background */
    color: black;                  /* black text */
    padding: 8px 20px;
    border: 1px solid #ccc;        /* light gray border */
    border-radius: 5px;           /* rounded rectangle */
    margin: 3px;
}

QTabBar::tab:selected {
    background: #f0f0f0;           /* light gray when active */
    font-weight: bold;
    border: 1px solid #999; 
border-bottom: 3px solid #2c3e50;       /* darker border for selected */
}

QTabBar::tab:hover {
    background: #e6e6e6;           /* hover effect */
}

QTabWidget::pane {
    border: 1px solid #ccc;
    border-radius: 10px;
    margin-top: 5px;
    background: white;
}
</string>
