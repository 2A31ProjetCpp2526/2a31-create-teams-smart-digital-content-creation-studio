         <widget class="QPushButton" name="pushButton_5">
          <property name="styleSheet">
           <string notr="true">QPushButton {
    background-color: gray;        /* Button color */
    color: white;                  /* Text color */
    border-radius: 8px;            /* Rounded corners */
    padding: 8px 15px;             /* Internal spacing */
    font-weight: bold;              /* Bold text */
    font-family: &quot;Poppins&quot;, sans-serif;
    border: none;                  /* Remove default border */
    min-width: 80px;               /* Optional minimum width */
    cursor: pointer;
}

QPushButton:hover {
    background-color: #555555;     /* Slightly darker on hover */
}

QPushButton:pressed {
    background-color: #333333;     /* Even darker when pressed */
}
</string>
