  <property name="styleSheet">
   <string>QMainWindow {
    background-color: #f8f9fa;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabWidget::pane {
    border: 1px solid #e1e8ed;
    border-radius: 8px;
    background-color: #ffffff;
    margin-top: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 12px 20px;
    margin-right: 2px;
    font-weight: 700; /* make tab text bold */
    color: #495057;
    font-size: 14px;
    min-width: 100px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #007bff;
    border-color: #007bff;
    border-bottom: 1px solid #ffffff;
}

QTableWidget {
    gridline-color: #e9ecef;
    background-color: #ffffff;
    alternate-background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #e9ecef;
}

QTableWidget::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QHeaderView::section {
    background-color: #f1f3f4;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #007bff;
    font-weight: 600;
    color: #495057;
}

QPushButton {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
}

/* Service Management Button Colors */
QPushButton#exportCsvBtn {
    background-color: #28a745;
    color: white;
}

QPushButton#exportCsvBtn:hover {
    background-color: #218838;
}

QPushButton#btnSortByName {
    background-color: #17a2b8;
    color: white;
}

QPushButton#btnSortByName:hover {
    background-color: #138496;
}

QPushButton#btnEditService {
    /* Modified to match reference: yellow/golden modify button */
    background-color: #f5b400;
    color: white;
    font-weight: 600;
    border-radius: 10px;
    padding: 10px 20px;
}

QPushButton#btnEditService:hover {
    background-color: #e0a800;
}

QPushButton#btnEditService:disabled {
    background-color: #6c757d;
    color: #ffffff;
}

QPushButton#btnDeleteService {
    background-color: #e53935;
    color: white;
    border-radius: 10px;
    padding: 10px 20px;
}

QPushButton#btnDeleteService:hover {
    background-color: #c62828;
}

QPushButton#btnDeleteService:disabled {
    background-color: #6c757d;
    color: #ffffff;
}

/* updateClientBtn removed from UI (Modify button removed from Clients tab) */

QLineEdit, QTextEdit, QComboBox {
    padding: 8px 12px;
    border: 2px solid #d0d7dd;
    border-radius: 12px;
    background-color: #ffffff;
    color: #000000;
    font-size: 14px;
}

QLineEdit:hover {
    border: 2px solid #4da3ff;
}

QLineEdit:focus {
    border: 2px solid #007bff;
    outline: none;
}

QLabel {
    color: #000000;
    font-size: 14px;
    font-weight: 500;
}

QLabel#headerTitle {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    padding: 20px 0;
}
QLabel#headerTitle:hover {
    color: #1e88ff; /* light blue text on hover */
}
</string>
