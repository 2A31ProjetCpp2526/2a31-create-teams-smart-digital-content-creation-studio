             </property>
             <property name="styleSheet">
              <string notr="true">QLabel#signUpTitle {
    color: #1a202c;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 32px;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: transparent;
    padding: 0px 0px 32px 0px;
    text-align: center;
    margin-bottom: 24px;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
QLabel#signUpTitle:hover {
    color: #0f1419;
    text-shadow: 0 0 20px rgba(135, 206, 235, 0.8), 0 0 35px rgba(135, 206, 235, 0.5);
    transform: scale(1.03) translateY(-2px);
    letter-spacing: 2.5px;
}</string>
             </property>
             <property name="text">
              <string>Create Account</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignCenter</set>
             </property>
            </widget>
