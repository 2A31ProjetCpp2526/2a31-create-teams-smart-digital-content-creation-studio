          <property name="styleSheet">
           <string notr="true">QWidget#signUpFormContainer {
    background-color: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.04);
    padding: 48px 64px;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
QWidget#signUpFormContainer:hover {
    box-shadow: 0 32px 80px rgba(135, 206, 235, 0.25), 0 12px 28px rgba(135, 206, 235, 0.15);
    border-color: rgba(135, 206, 235, 0.4);
    transform: translateY(-8px) scale(1.01);
    background: linear-gradient(145deg, #ffffff 0%, rgba(135, 206, 235, 0.03) 100%);
}</string>
