                  </font>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">QLineEdit#firstNameLineEdit {
    padding: 16px 20px;
    margin: 4px 0px 8px 0px;
    border: 2px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    background-color: #fafbfc;
    color: #2c3e50;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: 0.8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04), inset 0 1px 3px rgba(0, 0, 0, 0.02);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
QLineEdit#firstNameLineEdit:focus {
    border-color: rgba(135, 206, 235, 0.8);
    outline: none;
    background-color: #ffffff;
    box-shadow: 0 6px 20px rgba(135, 206, 235, 0.25), inset 0 1px 3px rgba(135, 206, 235, 0.1);
    transform: scale(1.015) translateY(-1px);
    color: #1a202c;
}
QLineEdit#firstNameLineEdit:hover {
    border-color: rgba(135, 206, 235, 0.5);
    background-color: #ffffff;
    box-shadow: 0 4px 15px rgba(135, 206, 235, 0.15), inset 0 1px 3px rgba(135, 206, 235, 0.05);
    transform: translateY(-1px);
}</string>
