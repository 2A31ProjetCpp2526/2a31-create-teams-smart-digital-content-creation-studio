               <family>Poppins Slim</family>
               <pointsize>15</pointsize>
               <weight>400</weight>
               <bold>false</bold>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">QPushButton#createAccountButton {
    background: linear-gradient(135deg, #87CEEB 0%, #5DADE2 100%);
    color: #ffffff;
    border: none;
    border-radius: 16px;
    padding: 20px 34px;
    margin: 28px 0px 18px 0px;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 8px 25px rgba(135, 206, 235, 0.4);
}
QPushButton#createAccountButton:hover {
    background: linear-gradient(135deg, #60B8E8 0%, #87CEEB 100%);
    color: #ffffff;
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 15px 45px rgba(135, 206, 235, 0.65);
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.95);
    letter-spacing: 1.6px;
}
QPushButton#createAccountButton:pressed {
    background: linear-gradient(135deg, #4A9CD9 0%, #73C1E8 100%);
    color: #ffffff;
    transform: translateY(-2px) scale(1.015);
    box-shadow: 0 10px 30px rgba(135, 206, 235, 0.55);
}</string>
             </property>
             <property name="text">
              <string>Create Account</string>
             </property>
            </widget>
           </item>
           <!-- Back to Login Link -->
           <item>
            <widget class="QPushButton" name="backToLoginButton">
             <property name="font">
              <font>
               <family>Poppins Slim</family>
               <pointsize>13</pointsize>
               <weight>400</weight>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">QPushButton#backToLoginButton {
    background-color: transparent;
    color: #87CEEB;
    border: none;
    border-radius: 8px;
    font-family: 'Poppins Slim', sans-serif;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 1px;
    text-align: center;
    text-decoration: none;
    padding: 12px 18px;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
QPushButton#backToLoginButton:hover {
    background-color: transparent;
    color: #5DADE2;
    text-decoration: underline;
    transform: translateY(-1px);
    text-shadow: 0 0 12px rgba(135, 206, 235, 0.8);
    letter-spacing: 1.3px;
}</string>
             </property>
             <property name="text">
              <string>Already have an account? Sign In</string>
             </property>
             <property name="flat">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
