/* Amine Templar - Modern Flat Design Stylesheet */
/* Clean, minimal, sharp aesthetic with light blue highlights */

/* Global Application Styling */
* {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    letter-spacing: 0.5px;
}

QApplication {
    background-color: #ffffff;
    color: #2c3e50;
}

/* Main Window with Background Image */
QMainWindow {
    background-image: url(:/images/background.jpg);
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
    background-size: cover;
    color: #2c3e50;
}

/* Sidebar Styling - Modern Flat Design */
QWidget#sidebarWidget {
    background-color: #fafbfc;
    border-right: 1px solid #e1e8ed;
    border-radius: 0;
}

QWidget#sidebarWidget QPushButton {
    text-align: left;
    padding: 16px 24px;
    border: none;
    background-color: transparent;
    color: #657786;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0.5px;
    border-radius: 0;
    margin: 0 0;
    min-height: 22px;
    border-left: 3px solid transparent;
}

QWidget#sidebarWidget QPushButton:hover {
    background-color: #f7f9fa;
    color: #1da1f2;
    border-left: 3px solid #1da1f2;
}

QWidget#sidebarWidget QPushButton:pressed {
    background-color: #e8f4fd;
    color: #0c7abf;
}

QWidget#sidebarWidget QPushButton:checked {
    background-color: #e8f4fd;
    color: #1da1f2;
    font-weight: 500;
    border-left: 3px solid #1da1f2;
}

/* Header Styling - Clean Flat Design */
QWidget#headerWidget {
    background-color: #ffffff;
    border-bottom: 1px solid #e1e8ed;
    border-radius: 0;
}

/* Login Button - Modern Flat Design */
QPushButton#loginBtn {
    background-color: #1da1f2;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 28px;
    font-weight: 500;
    letter-spacing: 0.5px;
    min-width: 130px;
    min-height: 42px;
}

QPushButton#loginBtn:hover {
    background-color: #0c8bd9;
}

QPushButton#loginBtn:pressed {
    background-color: #0a7bc4;
}

/* Content Area - Enhanced with subtle background */
QWidget#mainContentWidget {
    background-color: #fdfdfd;
}

/* Page Titles - Enhanced with glow effects */
QLabel[class="pageTitle"] {
    font-size: 26px;
    font-weight: 300;
    color: #2c3e50;
    letter-spacing: 1.2px;
    margin-bottom: 20px;
    text-shadow: 0 2px 4px rgba(52, 152, 219, 0.15);
}

/* Stacked Widget Pages */
QStackedWidget {
    background-color: #ffffff;
}

/* Form Elements - Modern Flat Design */
QLineEdit {
    padding: 14px 18px;
    border: 1px solid #ced6e0;
    border-radius: 6px;
    background-color: #ffffff;
    color: #2c3e50;
    font-weight: 300;
    letter-spacing: 0.5px;
    min-height: 22px;
}

QLineEdit:focus {
    border-color: #1da1f2;
    outline: none;
    background-color: #ffffff;
}

QLineEdit:hover {
    border-color: #a4b0be;
    background-color: #ffffff;
}

/* Buttons - Modern Flat Design */
QPushButton {
    background-color: #1da1f2;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-weight: 500;
    letter-spacing: 0.5px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #0c8bd9;
}

QPushButton:pressed {
    background-color: #0a7bc4;
}

QPushButton:disabled {
    background-color: #ced6e0;
    color: #a4b0be;
}

/* Secondary Buttons - Clean Flat Design */
QPushButton[class="secondary"] {
    background-color: #57606f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-weight: 500;
    letter-spacing: 0.5px;
}

QPushButton[class="secondary"]:hover {
    background-color: #4a5568;
}

/* ComboBox - Modern Flat Design */
QComboBox {
    padding: 12px 16px;
    border: 1px solid #ced6e0;
    border-radius: 6px;
    background-color: white;
    color: #2c3e50;
    font-weight: 300;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #a4b0be;
    background-color: white;
}

QComboBox:focus {
    border-color: #1da1f2;
    outline: none;
}

QComboBox:focus {
    border-color: #3498db;
    box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.15);
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    border-radius: 0 8px 8px 0;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid #3498db;
    margin-right: 8px;
}

/* SpinBox - Enhanced styling */
QSpinBox {
    padding: 12px 16px;
    border: 2px solid rgba(52, 152, 219, 0.2);
    border-radius: 8px;
    background-color: white;
    color: #2c3e50;
    font-weight: 300;
    min-height: 22px;
}

QSpinBox:hover {
    border-color: rgba(52, 152, 219, 0.4);
    background-color: #fafbfc;
}

QSpinBox:focus {
    border-color: #3498db;
    box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.15);
}

/* GroupBox - Enhanced with subtle styling */
QGroupBox {
    color: #2c3e50;
    font-weight: 400;
    letter-spacing: 0.6px;
    border: 2px solid rgba(52, 152, 219, 0.15);
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 20px;
}

QGroupBox::title {
    left: 20px;
    padding: 0 12px 0 12px;
    color: #2980b9;
    font-weight: 500;
    text-shadow: 0 1px 2px rgba(52, 152, 219, 0.1);
}

/* Cards - Enhanced with modern effects */
QWidget[class="card"] {
    background-color: #ffffff;
    border: 1px solid rgba(52, 152, 219, 0.1);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(52, 152, 219, 0.08);
}

QWidget[class="card"]:hover {
    background-color: #fafbfc;
    border-color: rgba(52, 152, 219, 0.2);
    box-shadow: 0 6px 25px rgba(52, 152, 219, 0.12);
}

/* Canvas/Editor Area - Enhanced styling */
QWidget#editorCanvas {
    background-color: #f8fafe;
    border: 2px dashed rgba(52, 152, 219, 0.3);
    border-radius: 12px;
}

/* Login Container - Enhanced with premium look */
QWidget#loginContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                stop:0 #ffffff, 
                stop:1 #fafbfc);
    border: 1px solid rgba(52, 152, 219, 0.15);
    border-radius: 18px;
    box-shadow: 0 12px 40px rgba(52, 152, 219, 0.15);
}

/* ScrollBar - Enhanced with modern styling */
QScrollBar:vertical {
    background-color: #f8fafe;
    width: 14px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                stop:0 #74b9ff, 
                stop:1 #3498db);
    border-radius: 7px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                stop:0 #81c2ff, 
                stop:1 #5dade2);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* Tooltips - Enhanced with modern styling */
QToolTip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                stop:0 #2c3e50, 
                stop:1 #34495e);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    font-weight: 300;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

/* Animation Classes - Enhanced transitions */
.fade-in {
    animation: fadeIn 0.4s ease-in-out;
}

.slide-left {
    animation: slideLeft 0.3s ease-out;
}

.slide-right {
    animation: slideRight 0.3s ease-out;
}